# deps
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# OS / editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# next.js
.next/
out/

# production
build/

# runtime config (never committed — written by identuum-ui-setup)
config/ui-runtime.json

# env files
.env*.local
# operator-supplied smoke harness env files (never committed)
.smoke-org-import.env
*.smoke.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.gograph/


# test artifacts
playwright-report/
test-results/
# vitest coverage output (opt-in via `vitest run --coverage`; not part
# of the default `pnpm test` script, but a realistic ad-hoc local run).
coverage/
# Local E2E fixture material written by the released-appliance harness
# (e2e/global-setup.ts → e2e/helpers/appliance-fixture.ts). Holds the
# generated fixture envelope (org/admin/user credentials + captured TOTP
# secrets), the non-secret org handle, and the isolated e2e ui-runtime config.
# Never committed. (Was the pre-split `identuum --e2e-create-org-admin-fixture`
# CLI, retired in THE-RELEASED-CONTRACT.)
e2e/.auth/
# e2e-full owns its own run-local state (THE-AUTH-SWEEP): the disposable
# suite must not depend on a path the dev-loop suite owns.
/e2e-full/.auth/

# local agent instructions — local-only development-agent guidance,
# must not be committed
CLAUDE.md
/AGENTS.md

# Local-only MCP / AI tooling configuration (e.g. gograph MCP server
# binding). Per-developer; may carry tokens or local paths in future
# contributor checkouts. Never publish. Mirrors the OSS-side rule in
# identuum-idp-oss/.gitignore.
.mcp.json
src/.tsgraph

# CI witness record (THE-UNWITNESSED-MIRROR): written step-by-step by the CI
# job and uploaded as an artifact; never committed — a local write must not
# read as an edit to the committed GATE-RUN.txt record's tree digest.
/GATE-RUN.ci.txt
# The e2e-full harness's witnessed coverage record (THE-WITNESSED-COVERAGE):
# gitignored for the SAME reason as the CI record — a harness run must not
# stale the committed verify record's digest (and vice versa; two committed
# records would each cover the other). `gate-witness check . GATE-RUN.e2e-full.txt`
# still re-verifies it against the tree it ran on.
/GATE-RUN.e2e-full.txt
