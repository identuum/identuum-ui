{
  "name": "identuum-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "next dev --port 7104",
    "build": "next build",
    "start": "PORT=7104 node .next/standalone/server.js",
    "config:idp-only": "node scripts/ui-runtime-preset.mjs idp-only",
    "config:hybrid": "node scripts/ui-runtime-preset.mjs hybrid",
    "config:ag-only": "node scripts/ui-runtime-preset.mjs ag-only",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "rulefloor": "(test -x ../rulefloor/rulefloor || (cd ../rulefloor && go build -o rulefloor .)) && ../rulefloor/rulefloor check --repo .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:upgrade-backup-live": "./e2e/scripts/run-upgrade-backup-live.sh",
    "e2e:oss-site-admin-smoke": "./e2e/scripts/run-oss-site-admin-smoke.sh",
    "e2e:oss-wizard-ui": "./e2e/scripts/run-oss-wizard-ui.sh",
    "e2e:ce-customer-smoke": "IDENTUUM_E2E_CE_CUSTOMER_SMOKE=1 IDENTUUM_E2E_CE_LICENSE_UI_PREPARED=1 IDP_BASE_URL=${IDP_BASE_URL:-http://127.0.0.1:7123} IDENTUUM_E2E_BASE_URL=${IDENTUUM_E2E_BASE_URL:-http://127.0.0.1:7124} playwright test e2e/ce-customer-smoke-license-status.spec.ts",
    "e2e:ce-customer-smoke-passkey": "IDENTUUM_E2E_CE_CUSTOMER_SMOKE=1 IDP_BASE_URL=${IDP_BASE_URL:-http://localhost:7123} IDENTUUM_E2E_BASE_URL=${IDENTUUM_E2E_BASE_URL:-http://localhost:7124} WEBAUTHN_UI_BASE_URL=${WEBAUTHN_UI_BASE_URL:-http://localhost:7124} playwright test e2e/passkey-flow.spec.ts",
    "e2e:oss-customer-smoke-passkey": "IDENTUUM_E2E_OSS_CUSTOMER_SMOKE=1 IDP_BASE_URL=${IDP_BASE_URL:-http://localhost:7113} IDENTUUM_E2E_BASE_URL=${IDENTUUM_E2E_BASE_URL:-http://localhost:7114} WEBAUTHN_UI_BASE_URL=${WEBAUTHN_UI_BASE_URL:-http://localhost:7114} playwright test e2e/passkey-flow.spec.ts",
    "e2e:ce-fresh-m1-setup": "IDENTUUM_E2E_CE_FRESH_M1=1 IDP_BASE_URL=${IDP_BASE_URL:-http://localhost:7125} IDENTUUM_E2E_BASE_URL=${IDENTUUM_E2E_BASE_URL:-http://localhost:7126} playwright test e2e/ce-fresh-m1-setup.spec.ts"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.19.19",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.6"
  }
}
