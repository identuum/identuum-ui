{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "suspicious": {
        // Off deliberately (THE-TS-SEVEN, Biome 2 migration): this repo's
        // source-invariant tests QUOTE template-literal syntax inside plain
        // strings on purpose (asserting on `${idpBaseUrl(...)}`-shaped
        // source). The rule fired 19 times, every one a deliberate fixture.
        "noTemplateCurlyInString": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/out",
      "!**/playwright-report",
      "!**/test-results",
      "!**/.playwright",
      "!**/.gograph",
      "!**/.tsgraph",
      "!**/config/ui-runtime.json",
      // Run artifacts, machine-written and gitignored: the e2e credential
      // envelopes plus the harness's Playwright JSON reports (minified by
      // Playwright itself — not formattable source). THE-WITNESSED-COVERAGE:
      // biome flagged the reports the moment the harness started writing them.
      "!**/e2e/.auth",
      "!**/e2e-full/.auth"
    ]
  }
}
